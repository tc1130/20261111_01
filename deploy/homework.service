[Unit]
Description=Homework Collection Website (Flask + Gunicorn)
After=network.target

[Service]
User=admin
Group=admin
WorkingDirectory=/home/admin/homework
# worker 数：4 个进程（提升读并发）；SQLite 写并发由 app.py 里的 WAL + busy_timeout 兜底
ExecStart=/home/admin/homework/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
